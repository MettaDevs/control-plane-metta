{
    "name": "control-plane-metta",
    "private": true,
    "type": "module",
    "scripts": {
        "typecheck": "tsc --noEmit",
        "test": "bun test",
        "build": "bun build src/console.ts src/agent.ts src/cli.ts --target=bun --outdir dist --minify",
        "start:console": "bun src/console.ts",
        "start:agent": "bun src/agent.ts",
        "format": "prettier --write src scripts .github package.json tsconfig.json",
        "format:check": "prettier --check src scripts .github package.json tsconfig.json",
        "check:boundaries": "bun scripts/check-boundaries.ts",
        "migrate": "bun scripts/migrate.ts",
        "cli": "bun src/cli.ts"
    },
    "dependencies": {
        "@orpc/openapi": "1.16.1",
        "@orpc/server": "1.16.1",
        "elysia": "1.4.30",
        "postgres": "3.4.7",
        "zod": "4.6.7"
    },
    "devDependencies": {
        "@types/bun": "1.4.4",
        "prettier": "3.9.5",
        "typescript": "5.9.3"
    }
}
