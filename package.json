{
    "name": "control-plane-metta",
    "private": true,
    "type": "module",
    "workspaces": [
        "packages/*"
    ],
    "scripts": {
        "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.portal.json && tsc --noEmit -p packages/ui",
        "test": "bun test",
        "build": "bun scripts/generate-client.ts && bun scripts/build.ts",
        "dev": "bun scripts/dev.ts",
        "dev:portal": "bun scripts/dev.ts portal",
        "dev:stack": "bun scripts/dev-stack.ts",
        "start:console": "bun src/console.ts",
        "start:agent": "bun src/agent.ts",
        "start:portal": "bun src/portal.ts",
        "format": "prettier --write src packages scripts test .github package.json tsconfig.json tsconfig.portal.json",
        "format:check": "prettier --check src packages scripts test .github package.json tsconfig.json tsconfig.portal.json",
        "check:boundaries": "bun scripts/check-boundaries.ts",
        "check:generated": "bun scripts/generate-client.ts --check",
        "migrate": "bun src/migrate.ts",
        "cli": "bun src/cli.ts"
    },
    "dependencies": {
        "@control-plane-metta/ui": "workspace:*",
        "@orpc/client": "1.16.1",
        "@orpc/openapi": "1.16.1",
        "@orpc/openapi-client": "1.16.1",
        "@orpc/server": "1.16.1",
        "@orpc/tanstack-query": "1.16.1",
        "@sentry/bun": "11.9.0",
        "@tanstack/react-query": "5.105.0",
        "@tanstack/react-router": "1.170.46",
        "elysia": "1.4.30",
        "lucide-react": "0.475.0",
        "postgres": "3.4.7",
        "react": "19.2.7",
        "react-dom": "19.2.7",
        "sonner": "2.0.7",
        "zod": "4.6.7"
    },
    "devDependencies": {
        "@orpc/contract": "1.16.1",
        "@tailwindcss/node": "4.3.2",
        "@tailwindcss/oxide": "4.3.2",
        "@types/bun": "1.4.4",
        "@types/react": "19.2.17",
        "@types/react-dom": "19.2.3",
        "prettier": "3.9.5",
        "prettier-plugin-tailwindcss": "0.6.14",
        "tailwindcss": "4.3.2",
        "tw-animate-css": "1.4.0",
        "typescript": "5.9.3"
    }
}
