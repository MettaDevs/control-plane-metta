{
    "compilerOptions": {
        "target": "ES2024",
        "module": "Preserve",
        "moduleResolution": "Bundler",
        "lib": ["ES2024", "DOM", "DOM.Iterable"],
        "types": ["bun"],
        "jsx": "react-jsx",
        "strict": true,
        "noUncheckedIndexedAccess": true,
        "noFallthroughCasesInSwitch": true,
        "noEmit": true,
        "skipLibCheck": true,
        "verbatimModuleSyntax": true,
        "allowImportingTsExtensions": true,
        "resolveJsonModule": true
    },
    "include": [
        "src/**/*.ts",
        "src/**/*.tsx",
        "scripts/**/*.ts",
        "test/**/*.ts"
    ],
    "exclude": [
        "src/portal-client.tsx",
        "src/**/*.portal.page.tsx",
        "src/platform/shell/*.portal.ts",
        "src/platform/shell/*.portal.tsx"
    ]
}
